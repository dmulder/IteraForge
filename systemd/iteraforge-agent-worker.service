[Unit]
Description=IteraForge host agent worker
After=iteraforge.service

[Service]
Type=simple
Environment=ITERAFORGE_CONFIG_HOME=%h/.config/iteraforge
Environment=ITERAFORGE_DATA_HOME=%h/.local/share/iteraforge
ExecStart=%h/.local/bin/iteraforge-agent-worker
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
